# Copy to .env and replace every value (or run ./start-infrastructure.sh,
# which generates a .env with random values). .env is git-ignored.
# Generate a value with: openssl rand -base64 24 | tr -d '/+='

POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Imported into the coghealth realm (docker/keycloak/coghealth-realm.json)
KC_REALM_ADMIN_PASSWORD=change-me
KC_DEMO_USER_PASSWORD=change-me
KC_API_CLIENT_SECRET=change-me

RABBITMQ_USER=coghealth
RABBITMQ_PASSWORD=change-me
